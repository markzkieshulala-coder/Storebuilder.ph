# Database
DATABASE_URL="postgresql://user:password@localhost:5432/storebuilder"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Prompt understanding is 100% in-house and in-process.
# The website generator uses its own NLU engine (lib/engine/nlu) plus the
# deterministic parser (lib/engine/prompt-engine) to understand the user's prompt
# and build the site. There is NO external AI API of any kind — no Anthropic,
# OpenAI, Google/Gemini, or Ollama — and no network call is required to generate
# a website. Nothing to configure here.

# PayMongo
PAYMONGO_SECRET_KEY="sk_test_your-paymongo-secret-key"
PAYMONGO_PUBLIC_KEY="pk_test_your-paymongo-public-key"

# Cloudflare
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY="pk_test_your-paymongo-public-key"

# Email (nodemailer)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@storebuilder.ph"

# USD to PHP conversion rate (update periodically)
USD_TO_PHP_RATE="57.5"

# In-house image engine. Images are NEVER sourced from third parties (no Unsplash,
# Pexels, stock APIs, or shared CDN). Two in-house paths:
#  1) Optional self-hosted Stable Diffusion / SDXL service at IMAGE_GEN_URL
#     (your own machine/server — NOT a third party). Auto-probed: if it responds,
#     it's used; otherwise the engine silently uses the in-process visual engine.
#     See tools/image-generator/README.md.
#  2) The in-process generative visual engine — always available, no network,
#     unique per prompt+slot (no repeats, even for the same niche).
# Set IMAGE_GEN_ENABLED=0 to skip the self-hosted generator entirely.
IMAGE_GEN_ENABLED="1"
IMAGE_GEN_URL="http://127.0.0.1:7860"
IMAGE_GEN_COUNT="12"
IMAGE_GEN_STEPS="6"
IMAGE_GEN_CFG="2"
IMAGE_GEN_TIMEOUT_MS="25000"
