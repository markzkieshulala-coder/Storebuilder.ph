# Database
DATABASE_URL="postgresql://user:password@localhost:5432/storebuilder"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Anthropic Claude API (content fill step)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Google Stitch API (design generation — get key at stitch.withgoogle.com)
STITCH_API_KEY="your-stitch-api-key"

# Mock mode - set to true to skip Claude API calls during development
MOCK_MODE="false"

# PayMongo
PAYMONGO_SECRET_KEY="sk_test_your-paymongo-secret-key"
PAYMONGO_PUBLIC_KEY="pk_test_your-paymongo-public-key"

# Cloudflare
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY="pk_test_your-paymongo-public-key"

# Email (nodemailer)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@storebuilder.ph"

# USD to PHP conversion rate (update periodically)
USD_TO_PHP_RATE="57.5"

# Self-hosted image generator (your own Stable Diffusion service — NOT a third party).
# See tools/image-generator/README.md. When disabled, the engine uses built-in SVG art.
IMAGE_GEN_ENABLED="0"
IMAGE_GEN_URL="http://127.0.0.1:7860"
IMAGE_GEN_COUNT="6"
IMAGE_GEN_STEPS="6"
IMAGE_GEN_CFG="2"
IMAGE_GEN_TIMEOUT_MS="25000"

# Optional: exact keyword photo search (real photos matched to the prompt).
# Leave blank to use the keyless curated real-photo library (still real photos).
# Free keys: https://unsplash.com/developers  and  https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""
