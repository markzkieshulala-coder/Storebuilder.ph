# Database
DATABASE_URL="postgresql://user:password@localhost:5432/storebuilder"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Website generation — hybrid AI pipeline (REQUIRED to generate sites).
# The generator now uses Claude to interpret the prompt and plan the site
# (sections, CTAs, copy, exclusions); a deterministic in-house engine renders that
# plan into a premium 3D ultra-modern HTML document. The model strictly follows the
# prompt — it includes only what is asked for and honours explicit exclusions
# (e.g. "no FAQ", "no testimonials"). Without this key, /api/generate returns 503.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# PayMongo
PAYMONGO_SECRET_KEY="sk_test_your-paymongo-secret-key"
PAYMONGO_PUBLIC_KEY="pk_test_your-paymongo-public-key"

# Cloudflare
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY="pk_test_your-paymongo-public-key"

# Email (nodemailer)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@storebuilder.ph"

# USD to PHP conversion rate (update periodically)
USD_TO_PHP_RATE="57.5"

# Visuals — content-aware Pexels photos, globally unique per build.
# Each section is resolved from the EXACT content it shows (product/service names,
# niche, branding); a persistent ledger guarantees no image is ever reused across
# builds, even within the same niche. Without a key, every slot falls back to a
# branded CSS placeholder (site generation still works).
# Get a free key at https://www.pexels.com/api/ (create account → Your API key).
PEXELS_API_KEY=""
# Optional tuning:
PEXELS_BUDGET_MS="30000"      # total wall-clock budget for the whole image phase
PEXELS_TIMEOUT_MS="8000"      # per-search request timeout
