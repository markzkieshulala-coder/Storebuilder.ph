# Database
DATABASE_URL="postgresql://user:password@localhost:5432/storebuilder"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Website generation — AI engine (REQUIRED to generate sites).
# The generator calls an OpenAI-compatible chat engine that reads the prompt and
# writes the ENTIRE website directly (structure, sections, pages, CTAs, copy) —
# no templates, no fixed sections, no injected content. It strictly follows the
# prompt and honours explicit exclusions (e.g. "no FAQ"). Without AI_API_KEY,
# /api/generate returns 503.
#
# Point this at YOUR OWN engine or any OpenAI-compatible endpoint (OpenAI, Ollama,
# vLLM, LM Studio, LocalAI, DeepSeek, Groq, Together, …). The client POSTs to
# {AI_BASE_URL}/chat/completions with a Bearer token.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"   # e.g. http://localhost:11434/v1 for Ollama
AI_MODEL="gpt-4o"                          # any chat model your engine serves

# PayMongo
PAYMONGO_SECRET_KEY="sk_test_your-paymongo-secret-key"
PAYMONGO_PUBLIC_KEY="pk_test_your-paymongo-public-key"

# Cloudflare
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY="pk_test_your-paymongo-public-key"

# Email (nodemailer)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@storebuilder.ph"

# USD to PHP conversion rate (update periodically)
USD_TO_PHP_RATE="57.5"

# Visuals — content-aware Pexels photos, globally unique per build.
# Each section is resolved from the EXACT content it shows (product/service names,
# niche, branding); a persistent ledger guarantees no image is ever reused across
# builds, even within the same niche. Without a key, every slot falls back to a
# branded CSS placeholder (site generation still works).
# Get a free key at https://www.pexels.com/api/ (create account → Your API key).
PEXELS_API_KEY=""
# Optional tuning:
PEXELS_BUDGET_MS="30000"      # total wall-clock budget for the whole image phase
PEXELS_TIMEOUT_MS="8000"      # per-search request timeout
