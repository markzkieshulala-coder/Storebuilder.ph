// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token              String? @db.Text
  access_token               String? @db.Text
  expires_at                 Int?
  token_type                 String?
  scope                      String?
  id_token                   String? @db.Text
  session_state              String?
  refresh_token_expires_in   Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  location      String?
  isInfluencer  Boolean   @default(false)
  settings      Json?

  // Deferred plan change — when set, user will downgrade/cancel at planExpiresAt
  // pendingPlan is the plan they will become; null means no change pending.
  pendingPlan   Plan?
  pendingPlanAt DateTime?

  // Email change verification — pendingEmail is the new email awaiting OTP
  // confirmation from the CURRENT email; expires after 30 minutes.
  pendingEmail        String?
  pendingEmailToken   String?
  pendingEmailExpires DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  websites      Website[]
  creditUsage   CreditUsage[]
  editUsage     EditUsage[]
  tokenUsageLogs TokenUsageLog[]
  subscriptions Subscription[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Website {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        WebsiteType @default(BUSINESS)
  prompt      String   @db.Text
  jsonContent Json
  published   Boolean  @default(false)
  subdomain   String?  @unique
  customDomain String? @unique
  cfZoneId    String?
  cfRecordId  String?
  thumbnail   String?
  seoTitle    String?
  seoDesc     String?
  templateSlug    String?  @unique  // public slug for "Use template" link
  templateShared  Boolean  @default(false)  // is this site shared as a template?
  templateUseCount Int     @default(0)  // how many times template was used
  clonedFromId    String?  // if this site was created from a template
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeOrders        StoreOrder[]
  storeCustomers     StoreCustomer[]
  storeContacts      StoreContactSubmission[]
  storeSubscribers   StoreNewsletterSubscriber[]
  storeVisits        StoreVisit[]

  @@index([userId])
  @@index([subdomain])
  @@index([templateSlug])
}

// ENTERPRISE business management — orders captured from product checkout flow
model StoreOrder {
  id              String   @id @default(cuid())
  websiteId       String
  productId       String?
  productName     String
  quantity        Int      @default(1)
  unitPriceCents  Int
  totalCents      Int
  currency        String   @default("PHP")
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  notes           String?  @db.Text
  status          OrderStatus @default(PENDING)
  paymongoLinkId  String?
  paymongoCheckoutUrl String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  website         Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([customerEmail])
  @@index([status])
}

// CRM customer records — derived/upserted from orders + form submissions
model StoreCustomer {
  id              String   @id @default(cuid())
  websiteId       String
  email           String
  name            String?
  phone           String?
  totalSpentCents Int      @default(0)
  orderCount      Int      @default(0)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  tags            String?  // comma-separated tags
  notes           String?  @db.Text

  website         Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, email])
  @@index([websiteId])
}

// Contact form submissions from the contact section
model StoreContactSubmission {
  id          String   @id @default(cuid())
  websiteId   String
  name        String
  email       String
  message     String   @db.Text
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([createdAt])
}

// Newsletter signups
model StoreNewsletterSubscriber {
  id          String   @id @default(cuid())
  websiteId   String
  email       String
  name        String?
  source      String?  // "newsletter_section" | "footer" | etc
  createdAt   DateTime @default(now())

  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, email])
  @@index([websiteId])
}

// Anonymous page visits — for traffic analytics
model StoreVisit {
  id          String   @id @default(cuid())
  websiteId   String
  path        String
  referrer    String?
  userAgent   String?  @db.Text
  country     String?
  createdAt   DateTime @default(now())

  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
}

model CreditUsage {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD in PH time (UTC+8)
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model EditUsage {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD in PH time
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model TokenUsageLog {
  id            String   @id @default(cuid())
  userId        String
  websiteId     String?
  model         String
  inputTokens   Int
  outputTokens  Int
  totalTokens   Int
  costUsd       Float
  costPhp       Float
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  paymongoId      String?  @unique
  status          SubStatus @default(PENDING)
  plan            Plan      @default(PRO)
  billingCycle    BillingCycle @default(MONTHLY)
  amount          Int      // in centavos
  currency        String   @default("PHP")
  paymentLinkUrl  String?

  // Deferred cancel — when true, subscription will not auto-renew and the
  // user keeps access until currentPeriodEnd. Set by /api/subscription/cancel.
  cancelAtPeriodEnd  Boolean  @default(false)
  currentPeriodEnd   DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum WebsiteType {
  STORE
  BUSINESS
  PORTFOLIO
  RESTAURANT
  SALON
  LANDING
}

enum SubStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}
